#!/usr/bin/env bash
#
# toggle-logs — toggle app logs pane
# Positioning: left of nvim if exists, else far left of window.

# ── Find project root ──────────────────────────────────────────────
path=$(tmux display-message -p '#{pane_current_path}')
while [[ "$path" != "/" ]]; do
  if [[ -f "$path/.envrc" ]]; then
    project_dir="$path"
    break
  fi
  path=$(dirname "$path")
done

if [[ -z "$project_dir" ]]; then
  tmux display-message "No .envrc found (not a project directory)"
  exit 1
fi

# ── Detect existing log pane (rl via console_ctl OR toggle-logs) ──
# Uses 'leftpane' marker (set by console_ctl) and docker compose logs
log_pane=$(tmux list-panes -F '#D #{pane_start_command}' 2>/dev/null \
  | grep -E 'leftpane.*docker compose logs|toggle-logs' \
  | head -n1 | awk '{print $1}')

if [[ -n "$log_pane" ]]; then
  # === KILL ===
  tmux kill-pane -t "$log_pane"
else
  # === SPAWN: position left of nvim, or far left ===
  nvim_pane=$(tmux list-panes -F '#D #{pane_current_command}' 2>/dev/null \
    | grep ' nvim$' | head -n1 | awk '{print $1}')

  if [[ -n "$nvim_pane" ]]; then
    tmux split-window -hb -l 40% -t "$nvim_pane" -c "$project_dir" \
      "bash -c 'source .envrc && echo toggle-logs > /dev/null && docker compose logs -f --no-log-prefix --tail=200 app; exec bash'"
  else
    tmux split-window -hb -l 40% -c "$project_dir" \
      "bash -c 'source .envrc && echo toggle-logs > /dev/null && docker compose logs -f --no-log-prefix --tail=200 app; exec bash'"
  fi
fi
