#!/usr/bin/env bash
#
# toggle-nvim — Ctrl+n: open nvim in left split, stash to void, restore
#
# Same stash/restore pattern as toggle-opencode.

curr_window=$(tmux display-message -p "#W")
void_session="${curr_window}_nvim_void"

# ── Detect nvim in current window ──────────────────────────────────
nvim_pane=$(tmux list-panes -F '#D #{pane_current_command}' 2>/dev/null \
  | grep -E ' nvim$| nvim ' \
  | head -n1 \
  | awk '{print $1}')
# Fallback: check pane_title for nvim (set by open-project)
if [[ -z "$nvim_pane" ]]; then
  nvim_pane=$(tmux list-panes -F '#D #{pane_title}' 2>/dev/null \
    | grep -i 'nvim' \
    | head -n1 \
    | awk '{print $1}')
fi

# ── State machine ──────────────────────────────────────────────────

if tmux has-session -t "${void_session}" 2>/dev/null; then
  # === RESTORE: void has stashed nvim → bring it back ===
  void_win=$(tmux list-windows -t "${void_session}" -F '#I' | head -n1)
  tmux join-pane -d -h -b -s "${void_session}:${void_win}"
  nvim_pane=$(tmux list-panes -F '#D #{pane_current_command}' | grep ' nvim$' | awk '{print $1}' | head -n1)
  tmux select-pane -t "$nvim_pane"
  tmux resize-pane -x 40%

elif [[ -n "$nvim_pane" ]]; then
  # === STASH: nvim is visible → hide it into void ===
  tmux new-session -d -s "$void_session"
  tmux break-pane -s "$nvim_pane" -d -t "${void_session}"
  tmux kill-window -t "${void_session}:0"

else
  # === SPAWN: no nvim anywhere → create one ===
  path=$(tmux display-message -p '#{pane_current_path}')
  tmux split-window -hb -l 40% -c "$path" "nvim"
fi
