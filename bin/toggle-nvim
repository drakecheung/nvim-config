#!/usr/bin/env bash
#
# toggle-nvim — Ctrl+n: toggle nvim in left pane (kill + replace, no void)

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$DIR/tmux-panes.sh"

target="${1:-}"
path=$(tmux display-message ${target:+-t "$target"} -p '#{pane_current_path}')

pane_lib::toggle_pane "nvim" \
  "bash -c 'source .envrc 2>/dev/null; nvim'" \
  "35%" \
  "$path" \
  "$target"
