#!/usr/bin/env bash
#
# toggle-opencode — Ctrl+o: single deterministic toggle via pane_lib.
#
# No send-keys, no custom state machine, no context branching.
# opencode is the ONLY type that spawns on the RIGHT (60% width).
#   visible         → stashed into ${win}_void_opencode
#   stashed in void → restored
#   neither         → spawned on the right
#
# To run opencode in-place from a plain shell, just type `opencode` — it
# already occupies the current pane without any split.

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$DIR/tmux-panes.sh"

target="${1:-}"
path=$(tmux display-message ${target:+-t "$target"} -p '#{pane_current_path}')

# A toggle pane is spawned via non-interactive `zsh -c`, which never sources
# ~/.zshrc — so the .env key block there is never applied and opencode starts
# without API keys. Load .env here, at spawn time, so the keys live only in the
# opencode process env while the key values stay solely in opencode-config/.env.
ENV_FILE="$HOME/.config/opencode/.env"

# The repo's .envrc is a second, separate env layer: it carries the devbase
# stack identity (COMPOSE_PROJECT_NAME / COMPOSE_FILE), which decides which
# stack `docker compose` / `reboot-dev` hits. Non-interactive panes get no
# direnv hook, so the pane must load it itself. direnv first (it honours the
# allow list and expands `use`/`dotenv`/`layout`), plain source as fallback for
# .envrc files direnv has not allowed. cwd is the repo (pane_lib::spawn -c).
pane_lib::toggle_pane "opencode" \
  "set -a; [ -f \"$ENV_FILE\" ] && . \"$ENV_FILE\"; set +a; \
   [ -f .envrc ] && { _e=\$(direnv export bash 2>/dev/null); [ -n \"\$_e\" ] && eval \"\$_e\" || . ./.envrc 2>/dev/null; }; \
   opencode -c 2>/dev/null || opencode" \
  "60%" "$path" "$target"
