#!/usr/bin/env bash
#
# toggle-focus — Ctrl+g: contextual layout control
#
# State machine:
#   1. Focus mode active  (@focus_left/@focus_right spacers exist) → EXIT
#   2. Single pane                                                → ENTER focus mode
#   3. Multiple panes (2+)                                        → REPOSITION left→25%

pane_alive() { tmux display-message -p -t "$1" '#D' &>/dev/null; }

focus_left=$(tmux show-option -wqv @focus_left 2>/dev/null)
focus_right=$(tmux show-option -wqv @focus_right 2>/dev/null)
pane_count=$(tmux list-panes -F '#D' | wc -l)

# ── State 1: Exit focus mode ─────────────────────────────────────
if [[ -n "$focus_left" && -n "$focus_right" ]] \
  && pane_alive "$focus_left" \
  && pane_alive "$focus_right"; then

  [[ -n "$focus_left" ]]  && tmux kill-pane -t "$focus_left"  2>/dev/null
  [[ -n "$focus_right" ]] && tmux kill-pane -t "$focus_right" 2>/dev/null
  tmux set-option -wu @focus_left  2>/dev/null
  tmux set-option -wu @focus_right 2>/dev/null

  win=$(tmux display-message -p '#W')
  void_session="${win}_focus_void"
  if tmux has-session -t "$void_session" 2>/dev/null; then
    while tmux list-windows -t "$void_session" -F '#I' 2>/dev/null | grep -q .; do
      void_win=$(tmux list-windows -t "$void_session" -F '#I' | head -n1)
      tmux join-pane -d -h -s "${void_session}:${void_win}" 2>/dev/null || break
    done
    tmux kill-session -t "$void_session" 2>/dev/null
  fi

# ── State 2: Enter focus mode (single pane) ──────────────────────
elif [[ $pane_count -eq 1 ]]; then

  win=$(tmux display-message -p '#W')
  void_session="${win}_focus_void"
  # Clean stale state
  tmux kill-session -t "$void_session" 2>/dev/null
  tmux set-option -wu @focus_left  2>/dev/null
  tmux set-option -wu @focus_right 2>/dev/null

  # Pin spacer panes to the current (middle) pane's cwd — otherwise a later
  # split of a spacer inherits a stale directory (e.g. another repo), and
  # direnv allow / devbase commands target the wrong project.
  mid=$(tmux display-message -p '#{pane_current_path}')
  left=$(tmux split-window -hbd -l 15% -c "$mid" -PF '#D' "sleep infinity")
  right=$(tmux split-window -hd  -l 15% -c "$mid" -PF '#D' "sleep infinity")
  tmux set-option -w @focus_left  "$left"
  tmux set-option -w @focus_right "$right"

# ── State 3: Reposition (2+ panes) → left pane 25% ───────────────
else

  leftmost=$(tmux list-panes -F '#{pane_id} #{pane_left}' \
    | sort -nk2 | head -n1 | awk '{print $1}')

  focused=$(tmux display-message -p '#D')
  tmux select-pane -t "$leftmost"
  tmux resize-pane -x 35%
  tmux select-pane -t "$focused"
fi
