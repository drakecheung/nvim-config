#!/usr/bin/env bash
#
# toggle-applogs — Ctrl+a: toggle app logs (left pane, auto-swap via void)

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$DIR/tmux-panes.sh"

target="${1:-}"
# ── Find project root ──────────────────────────────────────────────
project_dir=""
find_project() {
  local dir="$1"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.envrc" ]]; then
      project_dir="$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done
  return 1
}

find_project "$(tmux display-message ${target:+-t "$target"} -p '#{pane_current_path}')"
if [[ -z "$project_dir" ]]; then
  t_flag=""
  [[ -n "$target" ]] && t_flag="-t $target"
  while IFS= read -r pane_path; do
    find_project "$pane_path" && break
  done < <(tmux list-panes $t_flag -F '#{pane_current_path}' 2>/dev/null)
fi

if [[ -z "$project_dir" ]]; then
  tmux display-message "No project found (.envrc missing)"
  exit 1
fi

pane_lib::toggle_pane "applogs" \
  "bash -c 'source .envrc && docker-logs-follow . app'" \
  "35%" \
  "$project_dir" \
  "$target"
