#!/usr/bin/env bash
#
# toggle-applogs — toggle app logs (left pane, auto-swap via void)

source "$HOME/drake/nvim-config/bin/left-toggle.sh"

# ── Find project root ──────────────────────────────────────────────
project_dir=""
find_project() {
  local dir="$1"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.envrc" ]]; then
      project_dir="$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done
  return 1
}

find_project "$(tmux display-message -p '#{pane_current_path}')"
if [[ -z "$project_dir" ]]; then
  while IFS= read -r pane_path; do
    find_project "$pane_path" && break
  done < <(tmux list-panes -F '#{pane_current_path}' 2>/dev/null)
fi

if [[ -z "$project_dir" ]]; then
  tmux display-message "No project found (.envrc missing)"
  exit 1
fi

left_toggle "applogs" \
  "bash -c 'source .envrc && docker-logs-follow . app'" \
  "35%" \
  "$project_dir"
