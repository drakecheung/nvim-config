#!/usr/bin/env bash

# List all tmux sessions and their windows.
# Useful for debugging void sessions after toggle-pane.

tmux list-sessions -F "#{session_name}" 2>/dev/null | while read session; do
  echo "$session"
  tmux list-windows -t "$session" -F "  #{window_index}: #{window_name}" 2>/dev/null
done
