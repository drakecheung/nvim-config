#!/usr/bin/env bash
#
# toggle-sidebars — toggle left/right panes (hide → center expands, show → restore)
#
# Use case: press one key to hide nvim+logs on left, maximize opencode.
#           press again to bring them back.
#
# Bound to: Ctrl+g in tmux.conf (replaces toggle-focus)

win=$(tmux display-message -p '#W')
void_session="${win}_sidebar_void"

# ── Detect state: are sidebars stashed? ───────────────────────────
if tmux has-session -t "$void_session" 2>/dev/null; then
  # === RESTORE: bring stashed panes back ===
  while tmux list-windows -t "$void_session" -F '#I' 2>/dev/null | grep -q .; do
    void_win=$(tmux list-windows -t "$void_session" -F '#I' | head -n1)
    tmux join-pane -d -h -s "${void_session}:${void_win}" 2>/dev/null || break
  done
  tmux kill-session -t "$void_session" 2>/dev/null
  tmux display-message "Sidebars restored"

else
  # === STASH: hide side panes, keep center ===
  active=$(tmux display-message -p '#D')
  panes=$(tmux list-panes -F '#D')

  first=$(echo "$panes" | head -n1)
  last=$(echo  "$panes" | tail -n1)
  count=$(echo "$panes" | wc -l)

  # Only stash if there are side panes (3+ panes, active is the middle one)
  if [[ $count -ge 3 ]]; then
    tmux new-session -d -s "$void_session"
    for p in $panes; do
      [[ "$p" != "$active" ]] && tmux break-pane -s "$p" -d -t "$void_session"
    done
    tmux kill-window -t "${void_session}:0" 2>/dev/null
    tmux display-message "Sidebars hidden — Ctrl+g to restore"
  elif [[ $count -eq 2 ]]; then
    # 2 panes: stash the non-active one
    tmux new-session -d -s "$void_session"
    for p in $panes; do
      [[ "$p" != "$active" ]] && tmux break-pane -s "$p" -d -t "$void_session"
    done
    tmux kill-window -t "${void_session}:0" 2>/dev/null
    tmux display-message "Sidebar hidden — Ctrl+g to restore"
  else
    tmux display-message "Only one pane — nothing to stash"
  fi
fi
