#!/usr/bin/env bash

# Rebuild the tmux project list cache.
# Run this after adding a new project.vim.lua to a git repo.
# Bound to: Ctrl+Alt+R in tmux.conf

rm -f ~/.open-project.cache
list-projects > /dev/null
tmux display-message "Project cache rebuilt ($(wc -l < ~/.open-project.cache) projects)"
