#!/usr/bin/env node
//
// nvim-uid — screenshot a URL and draw it inside the current terminal pane.
//
//   nvim-uid <url>    render once and exit (quick test)
//   nvim-uid          daemon: listen on a FIFO for `url <url>` messages
//
// Renderer is chafa (ANSI blocks): no tmux passthrough, no X11 overlay, and
// `tmux capture-pane` can verify the output. Replaced ueberzug, which is dead
// on Python 3.12.

const puppeteer = require('puppeteer');
const fs = require('fs');
const child_process = require('child_process');

const projectName = process.env.COMPOSE_PROJECT_NAME || 'default';
const pipePath = `/tmp/nvim-uid-${projectName}.sock`;
const imgDir = `${process.env.HOME}/.nvim-uid`;
const imgPath = `${imgDir}/web.png`;

// Ubuntu 24.04 restricts unprivileged user namespaces, so Chrome's own sandbox
// cannot start (zygote_host_impl_linux.cc: "No usable sandbox"). --no-sandbox
// is the documented workaround; it also means any page rendered here runs
// unsandboxed, so only point this at your own dev servers.
const LAUNCH = {
  acceptInsecureCerts: true,
  args: ['--no-sandbox'],
  defaultViewport: { width: 1024, height: 768, deviceScaleFactor: 1.5 },
};

// Target this process's own pane, not whatever tmux thinks is the active
// client — `tmux display -p` without -t resolves to the most recently used
// client and gives the wrong size in a detached or multi-client session.
const paneSize = () => {
  if (process.env.TMUX_PANE) {
    return child_process
      .execSync(
        `tmux display-message -p -t '${process.env.TMUX_PANE}' '#{pane_width}x#{pane_height}'`,
      )
      .toString()
      .trim();
  }
  return `${process.stdout.columns || 80}x${process.stdout.rows || 24}`;
};

const draw = () => {
  process.stdout.write('\x1b[2J\x1b[H'); // clear pane, cursor home
  child_process.execFileSync('chafa', [`--size=${paneSize()}`, imgPath], {
    stdio: 'inherit',
  });
};

const shoot = async (page, url) => {
  await page.goto(url, { waitUntil: 'networkidle2', timeout: 30000 });
  await page.screenshot({ path: imgPath, fullPage: true });
  console.log(`screenshot: ${imgPath}`);
  draw();
};

const once = async (url) => {
  const browser = await puppeteer.launch(LAUNCH);
  try {
    await shoot(await browser.newPage(), url);
  } finally {
    await browser.close();
  }
};

const daemon = async () => {
  fs.mkdirSync(imgDir, { recursive: true });
  const browser = await puppeteer.launch(LAUNCH);
  const page = await browser.newPage();

  child_process.spawnSync('rm', ['-f', pipePath]);
  child_process.spawnSync('mkfifo', [pipePath]);
  const fd = fs.openSync(pipePath, fs.constants.O_RDWR);
  console.log(`listening on ${pipePath}`);

  const stream = fs.createReadStream(null, { fd, autoClose: false });
  stream.on('data', async (d) => {
    // Split on the first run of whitespace only: URLs may legitimately contain
    // spaces (data: URLs do), so `split(/\s+/)` would truncate them.
    const msg = d.toString().trim();
    const sep = msg.search(/\s/);
    if (sep < 0 || msg.slice(0, sep) !== 'url') return;
    const url = msg.slice(sep).trim();
    if (!url) return;
    console.log(`received: ${url}`);
    try {
      await shoot(page, url);
    } catch (e) {
      console.error(`render failed: ${e.message}`);
    }
  });

  const cleanup = () => {
    browser.close().catch(() => {});
    try { fs.closeSync(fd); } catch (_) {}
    try { fs.unlinkSync(pipePath); } catch (_) {}
    process.exit(0);
  };
  process.on('SIGINT', cleanup);
  process.on('SIGTERM', cleanup);
};

const url = process.argv[2];
(url ? once(url) : daemon()).catch((e) => {
  console.error(e.message);
  process.exit(1);
});
