#!/usr/bin/env bash
#
# toggle-db-console — toggle db console (left pane, auto-swap via void)

source "$HOME/drake/nvim-config/bin/left-toggle.sh"

# ── Find project root ──────────────────────────────────────────────
path=$(tmux display-message -p '#{pane_current_path}')
while [[ "$path" != "/" ]]; do
  if [[ -f "$path/.envrc" ]]; then
    project_dir="$path"
    proj_name=$(basename "$project_dir")
    break
  fi
  path=$(dirname "$path")
done

if [[ -z "$project_dir" ]]; then
  tmux display-message "No .envrc found (not a project directory)"
  exit 1
fi

left_toggle "db" \
  "bash -c 'source .envrc && docker compose exec db psql -U ${proj_name} -d ${proj_name} -P expanded=auto -P pager=off'" \
  "35%" \
  "$project_dir"
